{
  "name": "dinleti-cf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-release-manifest.mjs",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-pilot-content.mjs",
    "audit:catalog": "node scripts/audit-catalog-quality.mjs",
    "validate:catalog-quality": "node scripts/audit-catalog-quality.mjs --strict",
    "test:content": "node --test tests/content/*.spec.mjs",
    "test": "playwright test",
    "test:mobile": "playwright test --project=android-mobile --project=samsung-s24 --project=small-mobile",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.1"
  }
}
