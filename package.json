{
  "name": "dinleti-cf",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:production-catalog && npm run validate:ai-quality && vite build && node scripts/write-release-manifest.mjs",
    "preview": "vite preview",
    "validate:content": "node scripts/validate-pilot-content.mjs",
    "validate:production-catalog": "node scripts/validate-production-catalog.mjs",
    "validate:ai-quality": "node --test tests/content/ai-quality-gate.spec.mjs",
    "audit:content-by-age": "node scripts/validate-production-catalog.mjs",
    "test:content": "node --test tests/content/*.spec.mjs",
    "test": "playwright test",
    "test:mobile": "CROSS_PLATFORM=1 playwright test --project=android-mobile --project=samsung-s24 --project=small-mobile --project=iphone-safari --project=ipad-safari",
    "test:reader-contract": "playwright test tests/reader-cross-platform-contract.spec.js",
    "test:desktop": "playwright test --project=desktop-chrome",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "audit:full-catalog": "node scripts/audit-full-catalog.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "vite": "^8.1.1"
  }
}
